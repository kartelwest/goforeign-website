# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Backoffice access: magic-link sign-in is open to any email, but only
# emails present as an active row in the admin_users table can actually
# reach /admin (see TESTING.md "Seed your admin user"). No env var needed.

# Email (Resend) — Phase 6
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# Anthropic (Nu Nu) — Phase 5, server-side only, never exposed to the client
ANTHROPIC_API_KEY=
