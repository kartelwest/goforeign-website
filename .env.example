# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Backoffice access: magic-link sign-in is open to any email, but only
# emails present as an active row in the admin_users table can actually
# reach /admin (see TESTING.md "Seed your admin user"). No env var needed.

# Email (Resend)
RESEND_API_KEY=
# Where booking notifications go (your inbox)
NOTIFICATION_EMAIL=
# Must be on a domain verified in your Resend account, e.g. "Go Foreign <bookings@goforeign.com>"
RESEND_FROM_EMAIL=

# Anthropic (Nu Nu) — Phase 5, server-side only, never exposed to the client
ANTHROPIC_API_KEY=
